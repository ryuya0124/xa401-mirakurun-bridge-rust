events {}
http {
    map $http_upgrade $connection_upgrade { default upgrade; '' ''; }
    map $http_origin $origin_ok { default 0; '' 1; 'https://tv.example.net' 1; }
    server {
        listen 192.168.1.10:443 ssl;
        server_name tv.example.net;
        ssl_certificate /certs/fullchain.pem;
        ssl_certificate_key /certs/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        if ($host != 'tv.example.net') { return 421; }
        if ($origin_ok = 0) { return 403; }
        allow 192.168.1.0/24;
        allow 100.64.0.0/10;
        deny all;
        client_max_body_size 40m;
        location / {
            proxy_pass http://127.0.0.1:40772;
            proxy_http_version 1.1;
            proxy_set_header Host localhost:40772;
            proxy_set_header Origin '';
            proxy_set_header Forwarded '';
            proxy_set_header X-XA401-Frontend 1;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
        }
    }
}
